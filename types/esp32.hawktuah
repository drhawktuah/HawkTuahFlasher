# ESP32-WROOM-32 device definition
# @description Espressif ESP32 development board.
# @platform esp32

name = "ESP32-WROOM-32"
vendor = "Espressif"
family = "ESP32"

detect:
    # USB-to-UART VID
    # @description Espressif USB vendor ID
    vid = 0x303A

protocol:
    # @description ESP32 ROM bootloader protocol
    bootloader = "esptool"

flash:
    # @description Default flashing baud rate
    baudrate = 921600

    # Erase the flash before programming
    erase = true

    # Verify written data
    verify = true

custom:
    architecture = "xtensa"
    chip = "esp32"
    cores = 2
    wireless = true

cmake:
    toolchain = "xtensa-esp-elf"
    cpu_flags = "-mlongcalls -mtext-section-literals"